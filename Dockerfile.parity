# =============================================================================
#  Ironclad CMS Medicare Parity Validator — Docker image
# =============================================================================
#  Runs both engines side-by-side on every Medicare PPS Pricer test driver:
#     GnuCOBOL  →  cobc -x driver.cob program.cob  →  reference exe
#     Ironclad  →  rustc test_X.rs                 →  transpiled exe
#  Streams byte-for-byte parity results in real time.
#
#  Build:
#     docker build -t medicare-parity -f Dockerfile.parity .
#
#  Run (full battery):
#     docker run --rm medicare-parity
#
#  Filter to LTCH family only:
#     docker run --rm medicare-parity bash parity_harness.sh --filter LTCAL
# =============================================================================

FROM rust:1.85-slim-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gnucobol \
        coreutils \
        ca-certificates \
        build-essential && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /medicare

COPY cobol-runtime/ cobol-runtime/

RUN cd cobol-runtime && cargo build --release && cd ..

COPY cobol_source/ cobol_source/
COPY rust_drivers/ rust_drivers/

COPY parity_harness.sh .
RUN chmod +x parity_harness.sh

CMD ["bash", "parity_harness.sh", "--no-build"]
